# required for arm virt board, but missing https://qemu-project.gitlab.io/qemu/system/arm/virt.html#linux-guest-kernel-configuration
CONFIG_PCI_HOST_GENERIC=y

# squashfs
CONFIG_SQUASHFS=y

# fake wifi
CONFIG_MAC80211_HWSIM=y
CONFIG_MAC80211=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_CRYPTO_SHA256=y
